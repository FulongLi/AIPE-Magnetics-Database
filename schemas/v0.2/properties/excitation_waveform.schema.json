{
  "$defs": {
    "Original": {
      "additionalProperties": false,
      "description": "The value as supplied before unit normalisation.",
      "properties": {
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Original",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "``{value, unit}`` with optional provenance of the original unit and an uncertainty statement.",
      "properties": {
        "original": {
          "anyOf": [
            {
              "$ref": "#/$defs/Original"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uncertainty"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "description": "Uncertainty statement attached to a quantity.\n\n``kind='unknown'`` is the honest default when no quantitative basis exists.",
      "properties": {
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "how the uncertainty was obtained",
          "title": "Basis"
        },
        "coverage_factor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "k for expanded uncertainty",
          "title": "Coverage Factor"
        },
        "kind": {
          "default": "unknown",
          "enum": [
            "standard",
            "expanded",
            "bounds",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lower bound (kind='bounds')",
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "upper bound (kind='bounds')",
          "title": "Upper"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "standard/expanded uncertainty in the quantity unit",
          "title": "Value"
        }
      },
      "title": "Uncertainty",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/FulongLi/AIPE-Magnetics-Database/v0.2.0/schemas/v0.2/properties/excitation_waveform.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The 'properties' object of a 'excitation_waveform' record (ExcitationWaveformProperties). Parametric or sampled time-domain excitation description.\n\nSign convention: positive ``B``/``H``/voltage follow the right-hand rule around the winding\nreference direction stated in ``reference_direction``. Time starts at ``t=0`` at the beginning of\none steady-state period unless ``timebase`` says otherwise.",
  "properties": {
    "amplitude_peak": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "breakpoints": {
      "anyOf": [
        {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "piecewise-linear [t_fraction_of_period, value_fraction_of_peak] pairs",
      "title": "Breakpoints"
    },
    "controlled_quantity": {
      "default": "flux_density",
      "enum": [
        "flux_density",
        "field",
        "voltage",
        "current"
      ],
      "title": "Controlled Quantity",
      "type": "string"
    },
    "dataset_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "waveform_dataset record holding the samples",
      "title": "Dataset Ref"
    },
    "dc_offset": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "duty": {
      "anyOf": [
        {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duty"
    },
    "frequency": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reference_direction": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Direction"
    },
    "rise_fraction": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "trapezoid rise time / period",
      "title": "Rise Fraction"
    },
    "timebase": {
      "default": "periodic_from_zero",
      "enum": [
        "periodic_from_zero",
        "absolute"
      ],
      "title": "Timebase",
      "type": "string"
    },
    "waveform_type": {
      "enum": [
        "sinusoidal",
        "triangular",
        "trapezoidal",
        "square",
        "piecewise_linear",
        "sampled",
        "dc"
      ],
      "title": "Waveform Type",
      "type": "string"
    }
  },
  "required": [
    "waveform_type"
  ],
  "title": "AIPE magnetic record v0.2 - excitation_waveform properties",
  "type": "object"
}
