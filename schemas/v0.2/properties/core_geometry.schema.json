        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "sum(l/A), 1/m"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
