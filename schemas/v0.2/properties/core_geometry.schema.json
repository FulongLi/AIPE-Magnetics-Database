    },
    "material_refs": {
      "description": "materials this core is offered in",
      "items": {
        "type": "string"
      },
      "title": "Material Refs",
      "type": "array"
    },
    "mean_turn_length": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "minimum_area": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Amin"
    },
    "part_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Part Number"
    },
    "set_description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
