{
  "$defs": {
    "ConditionedValue": {
      "additionalProperties": false,
      "description": "A datasheet-style value valid at stated conditions, with its own source reference.",
      "properties": {
        "field": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "magnetic field strength H"
        },
        "flux_density_peak": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "frequency": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "evidence id",
          "title": "Source Ref"
        },
        "temperature": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "value"
      ],
      "title": "ConditionedValue",
      "type": "object"
    },
    "LossReferencePoint": {
      "additionalProperties": false,
      "description": "A single (f, Bpk, T) -> Pv point, typically a datasheet typical value or a measurement.",
      "properties": {
        "basis": {
          "default": "datasheet_typical",
          "enum": [
            "datasheet_typical",
            "measurement",
            "publication",
            "synthetic"
          ],
          "title": "Basis",
          "type": "string"
        },
        "dc_bias_field": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "duty": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duty"
        },
        "excitation": {
          "default": "sinusoidal",
          "enum": [
            "sinusoidal",
            "triangular",
            "trapezoidal",
            "square",
            "piecewise_linear",
            "sampled"
          ],
          "title": "Excitation",
          "type": "string"
        },
        "flux_density_peak": {
          "$ref": "#/$defs/Quantity"
        },
        "frequency": {
          "$ref": "#/$defs/Quantity"
        },
        "loss_density": {
          "$ref": "#/$defs/Quantity"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "temperature": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "frequency",
        "flux_density_peak",
        "loss_density"
      ],
      "title": "LossReferencePoint",
      "type": "object"
    },
    "Original": {
      "additionalProperties": false,
      "description": "The value as supplied before unit normalisation.",
      "properties": {
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Original",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "``{value, unit}`` with optional provenance of the original unit and an uncertainty statement.",
      "properties": {
        "original": {
          "anyOf": [
            {
              "$ref": "#/$defs/Original"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uncertainty"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "RangeSI": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "unit"
      ],
      "title": "RangeSI",
      "type": "object"
    },
    "SteinmetzParameterSet": {
      "additionalProperties": false,
      "description": "Classical Steinmetz parameters in SI form: ``Pv [W/m^3] = k * f[Hz]^alpha * Bpk[T]^beta``.\n\nParameters fitted in other unit systems (kHz, mT, kW/m^3) must be converted on import; the\n``original`` field of ``k`` records the pre-conversion value for reproducibility.",
      "properties": {
        "alpha": {
          "exclusiveMinimum": 0,
          "title": "Alpha",
          "type": "number"
        },
        "basis": {
          "enum": [
            "datasheet_fit",
            "measurement_fit",
            "publication",
            "manufacturer_supplied",
            "synthetic"
          ],
          "title": "Basis",
          "type": "string"
        },
        "beta": {
          "exclusiveMinimum": 0,
          "title": "Beta",
          "type": "number"
        },
        "excitation": {
          "const": "sinusoidal",
          "default": "sinusoidal",
          "title": "Excitation",
          "type": "string"
        },
        "fit_metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "e.g. max_rel_error, n_points",
          "title": "Fit Metrics",
          "type": "object"
        },
        "flux_density_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/RangeSI"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "frequency_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/RangeSI"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "k": {
          "$ref": "#/$defs/Quantity",
          "description": "W/m^3 with f in Hz and B in T"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "temperature": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "temperature at which the set was fitted"
        },
        "temperature_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/RangeSI"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "k",
        "alpha",
        "beta",
        "basis"
      ],
      "title": "SteinmetzParameterSet",
      "type": "object"
    },
    "TemperaturePoint": {
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "temperature": {
          "$ref": "#/$defs/Quantity"
        },
        "value": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "temperature",
        "value"
      ],
      "title": "TemperaturePoint",
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "description": "Uncertainty statement attached to a quantity.\n\n``kind='unknown'`` is the honest default when no quantitative basis exists.",
      "properties": {
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "how the uncertainty was obtained",
          "title": "Basis"
        },
        "coverage_factor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "k for expanded uncertainty",
          "title": "Coverage Factor"
        },
        "kind": {
          "default": "unknown",
          "enum": [
            "standard",
            "expanded",
            "bounds",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lower bound (kind='bounds')",
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "upper bound (kind='bounds')",
          "title": "Upper"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "standard/expanded uncertainty in the quantity unit",
          "title": "Value"
        }
      },
      "title": "Uncertainty",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/FulongLi/AIPE-Magnetics-Database/v0.2.0/schemas/v0.2/properties/magnetic_material.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The 'properties' object of a 'magnetic_material' record (MaterialProperties). Datasheet-level parameters of a soft magnetic material.",
  "properties": {
    "amplitude_permeability": {
      "items": {
        "$ref": "#/$defs/ConditionedValue"
      },
      "title": "Amplitude Permeability",
      "type": "array"
    },
    "coercivity": {
      "items": {
        "$ref": "#/$defs/ConditionedValue"
      },
      "title": "Coercivity",
      "type": "array"
    },
    "curie_temperature": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConditionedValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dc_bias_points": {
      "description": "permeability (or B) at stated DC field H",
      "items": {
        "$ref": "#/$defs/ConditionedValue"
      },
      "title": "Dc Bias Points",
      "type": "array"
    },
    "density": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConditionedValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "grade": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "manufacturer grade designation, e.g. N87",
      "title": "Grade"
    },
    "initial_permeability": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConditionedValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "loss_density_vs_temperature": {
      "items": {
        "$ref": "#/$defs/LossReferencePoint"
      },
      "title": "Loss Density Vs Temperature",
      "type": "array"
    },
    "loss_reference_points": {
      "items": {
        "$ref": "#/$defs/LossReferencePoint"
      },
      "title": "Loss Reference Points",
      "type": "array"
    },
    "manufacturer_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manufacturer Ref"
    },
    "material_class": {
      "anyOf": [
        {
          "enum": [
            "ferrite_mnzn",
            "ferrite_nizn",
            "powder_iron",
            "powder_alloy",
            "nanocrystalline",
            "amorphous",
            "silicon_steel",
            "other"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Material Class"
    },
    "permeability_vs_temperature": {
      "items": {
        "$ref": "#/$defs/TemperaturePoint"
      },
      "title": "Permeability Vs Temperature",
      "type": "array"
    },
    "recommended_frequency_range": {
      "anyOf": [
        {
          "$ref": "#/$defs/RangeSI"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "relative_permeability": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "v0.1 compatibility field"
    },
    "remanence": {
      "items": {
        "$ref": "#/$defs/ConditionedValue"
      },
      "title": "Remanence",
      "type": "array"
    },
    "resistivity": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConditionedValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "saturation_flux_density": {
      "description": "Bsat at stated H and T",
      "items": {
        "$ref": "#/$defs/ConditionedValue"
      },
      "title": "Saturation Flux Density",
      "type": "array"
    },
    "steinmetz_parameter_sets": {
      "items": {
        "$ref": "#/$defs/SteinmetzParameterSet"
      },
      "title": "Steinmetz Parameter Sets",
      "type": "array"
    }
  },
  "title": "AIPE magnetic record v0.2 - magnetic_material properties",
  "type": "object"
}
