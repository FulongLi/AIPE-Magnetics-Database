{
  "$defs": {
    "ArtifactRecord": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "description": "path relative to the state file directory",
          "title": "Path",
          "type": "string"
        },
        "produced_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Produced By"
        },
        "role": {
          "enum": [
            "specification",
            "cad",
            "mesh",
            "solver_configuration",
            "field_data",
            "results",
            "plot",
            "report",
            "bom",
            "selection_record",
            "verification_report",
            "state",
            "other"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        }
      },
      "required": [
        "id",
        "path",
        "media_type",
        "role"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "Component": {
