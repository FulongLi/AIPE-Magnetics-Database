{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/evidence.schema.json",
  "title": "AIPE Evidence",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/common.schema.json#/$defs/id"
    },
    "kind": {
      "enum": [
        "assumption",
        "analytical",
        "simulation",
        "measurement",
        "source"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "user_requirement",
            "document",
            "repository",
            "datasheet",
            "publication",
            "measurement_record",
            "synthetic_example"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "reference"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "created_at": {
          "$ref": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/common.schema.json#/$defs/timestamp"
        },
        "activity": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tool": {
          "$ref": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/common.schema.json#/$defs/attribution"
        },
        "skill": {
          "$ref": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/common.schema.json#/$defs/attribution"
        },
        "agent": {
          "$ref": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/common.schema.json#/$defs/attribution"
        },
        "inputs": {
          "$ref": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/common.schema.json#/$defs/evidence_refs"
        }
      },
      "required": [
        "created_at",
        "activity",
        "inputs"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/common.schema.json#/$defs/artifact"
      }
    },
    "review_status": {
      "enum": [
        "unreviewed",
        "reviewed",
        "rejected"
      ]
    },
    "extensions": {
      "$ref": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "id",
    "kind",
    "description",
    "source",
    "provenance",
    "artifacts",
    "review_status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "simulation",
              "measurement"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "artifacts": {
            "minItems": 1
          },
          "provenance": {
            "required": [
              "tool"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "measurement"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "type": {
                "const": "measurement_record"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "analytical"
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "properties": {
              "inputs": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
