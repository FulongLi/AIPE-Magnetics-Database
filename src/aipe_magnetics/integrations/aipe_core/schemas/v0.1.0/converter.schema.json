{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/converter.schema.json",
  "title": "AIPE Converter",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/common.schema.json#/$defs/id"
    },
    "topology": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "isolation": {
      "enum": [
        "isolated",
        "nonisolated",
        "unspecified"
      ]
    },
    "design_status": {
      "enum": [
        "concept",
        "candidate",
        "selected",
        "verified"
      ]
    },
    "evidence_refs": {
      "$ref": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/common.schema.json#/$defs/evidence_refs"
    },
    "extensions": {
      "$ref": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "id",
    "topology",
    "design_status",
    "evidence_refs"
  ],
  "additionalProperties": false
}
