{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/magnetics.schema.json",
  "title": "AIPE Magnetics",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/common.schema.json#/$defs/id"
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "inductor",
        "transformer",
        "coupled_inductor",
        "other"
      ]
    },
    "design_status": {
      "enum": [
        "unspecified",
        "candidate",
        "selected"
      ]
    },
    "database_ref": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1
    },
    "inductance": {
      "$ref": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/common.schema.json#/$defs/inductance"
    },
    "leakage_inductance": {
      "$ref": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/common.schema.json#/$defs/inductance"
    },
    "turns_ratio": {
      "$ref": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/common.schema.json#/$defs/ratio"
    },
    "core_material_ref": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1
    },
    "evidence_refs": {
      "$ref": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/common.schema.json#/$defs/evidence_refs"
    },
    "extensions": {
      "$ref": "https://raw.githubusercontent.com/FulongLi/AIPE-Core/v0.1.0/schemas/common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "id",
    "role",
    "kind",
    "design_status",
    "evidence_refs"
  ],
  "additionalProperties": false
}
