{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/FulongLi/AIPE-Magnetics-Database/v0.1.0/schemas/magnetic-record.schema.json",
  "title": "AIPE magnetic record v0.1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+(?:-[a-z0-9]+)*)+$"
    },
    "kind": {
      "enum": [
        "magnetic_material",
        "core_material",
        "core_family",
        "core_geometry",
        "winding",
        "inductor",
        "transformer",
        "magnetic_component",
        "loss_model",
        "measurement",
        "operating_condition"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+(?:-[a-z0-9]+)*)+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+(?:-[a-z0-9]+)*)+$"
          },
          "kind": {
            "enum": [
              "assumption",
              "source",
              "measurement",
              "analytical"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "review_status": {
            "enum": [
              "unreviewed",
              "reviewed",
              "rejected"
            ]
          },
          "license": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "reference",
          "description",
          "created_at",
          "review_status",
          "license"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "properties": {
      "type": "object"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*[.][a-z][a-z0-9_.-]*$"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "name",
    "synthetic",
    "properties",
    "evidence_refs",
    "evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "magnetic_material"
          }
        }
      },
      "then": {
        "properties": {
          "properties": {
            "type": "object",
            "properties": {
              "relative_permeability": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "const": "1"
                  }
                },
                "required": [
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "core_material"
          }
        }
      },
      "then": {
        "properties": {
          "properties": {
            "type": "object",
            "properties": {
              "material_ref": {
                "type": "string",
                "minLength": 1
              },
              "relative_permeability": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "const": "1"
                  }
                },
                "required": [
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "core_family"
          }
        }
      },
      "then": {
        "properties": {
          "properties": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "core_geometry"
          }
        }
      },
      "then": {
        "properties": {
          "properties": {
            "type": "object",
            "properties": {
              "family_ref": {
                "type": "string",
                "minLength": 1
              },
              "effective_area": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "const": "m^2"
                  }
                },
                "required": [
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              },
              "effective_length": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "const": "m"
                  }
                },
                "required": [
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              },
              "effective_volume": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "const": "m^3"
                  }
                },
                "required": [
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "winding"
          }
        }
      },
      "then": {
        "properties": {
          "properties": {
            "type": "object",
            "properties": {
              "turns": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "const": "1"
                  }
                },
                "required": [
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              },
              "conductor_area": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "const": "m^2"
                  }
                },
                "required": [
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "inductor"
          }
        }
      },
      "then": {
        "properties": {
          "properties": {
            "type": "object",
            "properties": {
              "core_ref": {
                "type": "string",
                "minLength": 1
              },
              "winding_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "inductance": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "const": "H"
                  }
                },
                "required": [
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "transformer"
          }
        }
      },
      "then": {
        "properties": {
          "properties": {
            "type": "object",
            "properties": {
              "core_ref": {
                "type": "string",
                "minLength": 1
              },
              "winding_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "leakage_inductance": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "const": "H"
                  }
                },
                "required": [
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              },
              "turns_ratio": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "const": "1"
                  }
                },
                "required": [
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "magnetic_component"
          }
        }
      },
      "then": {
        "properties": {
          "properties": {
            "type": "object",
            "properties": {
              "component_type": {
                "enum": [
                  "inductor",
                  "transformer",
                  "coupled_inductor",
                  "other"
                ]
              },
              "core_ref": {
                "type": "string",
                "minLength": 1
              },
              "winding_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "component_type"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "loss_model"
          }
        }
      },
      "then": {
        "properties": {
          "properties": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1
              },
              "model_artifact": {
                "type": "string",
                "format": "uri-reference",
                "minLength": 1
              },
              "operating_condition_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "method",
              "model_artifact"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "measurement"
          }
        }
      },
      "then": {
        "properties": {
          "properties": {
            "type": "object",
            "properties": {
              "component_ref": {
                "type": "string",
                "minLength": 1
              },
              "operating_condition_ref": {
                "type": "string",
                "minLength": 1
              },
              "artifact": {
                "type": "string",
                "format": "uri-reference",
                "minLength": 1
              },
              "tool": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name",
                  "version"
                ],
                "additionalProperties": false
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "component_ref",
              "operating_condition_ref",
              "artifact",
              "tool"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "operating_condition"
          }
        }
      },
      "then": {
        "properties": {
          "properties": {
            "type": "object",
            "properties": {
              "frequency": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "const": "Hz"
                  }
                },
                "required": [
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              },
              "flux_density_peak": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "const": "T"
                  }
                },
                "required": [
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              },
              "temperature": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "const": "K"
                  }
                },
                "required": [
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              },
              "current_rms": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "const": "A"
                  }
                },
                "required": [
                  "value",
                  "unit"
                ],
                "additionalProperties": false
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
