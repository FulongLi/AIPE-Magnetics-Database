          "title": "Basis"
        },
        "coverage_factor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "k for expanded uncertainty",
          "title": "Coverage Factor"
        },
        "kind": {
          "default": "unknown",
          "enum": [
            "standard",
            "expanded",
            "bounds",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lower bound (kind='bounds')",
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "upper bound (kind='bounds')",
          "title": "Upper"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
