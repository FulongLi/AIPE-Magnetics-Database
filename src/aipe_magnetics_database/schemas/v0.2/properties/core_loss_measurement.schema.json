{
  "$defs": {
    "LossReferencePoint": {
      "additionalProperties": false,
      "description": "A single (f, Bpk, T) -> Pv point, typically a datasheet typical value or a measurement.",
      "properties": {
        "basis": {
          "default": "datasheet_typical",
          "enum": [
            "datasheet_typical",
            "measurement",
            "publication",
            "synthetic"
          ],
          "title": "Basis",
          "type": "string"
        },
        "dc_bias_field": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "duty": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duty"
        },
        "excitation": {
          "default": "sinusoidal",
          "enum": [
            "sinusoidal",
            "triangular",
            "trapezoidal",
            "square",
            "piecewise_linear",
            "sampled"
          ],
          "title": "Excitation",
          "type": "string"
        },
        "flux_density_peak": {
          "$ref": "#/$defs/Quantity"
        },
        "frequency": {
          "$ref": "#/$defs/Quantity"
        },
        "loss_density": {
          "$ref": "#/$defs/Quantity"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "temperature": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "frequency",
        "flux_density_peak",
        "loss_density"
      ],
      "title": "LossReferencePoint",
      "type": "object"
    },
    "Original": {
      "additionalProperties": false,
      "description": "The value as supplied before unit normalisation.",
      "properties": {
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Original",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "``{value, unit}`` with optional provenance of the original unit and an uncertainty statement.",
      "properties": {
        "original": {
          "anyOf": [
            {
              "$ref": "#/$defs/Original"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uncertainty"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "description": "Uncertainty statement attached to a quantity.\n\n``kind='unknown'`` is the honest default when no quantitative basis exists.",
      "properties": {
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "how the uncertainty was obtained",
          "title": "Basis"
        },
        "coverage_factor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "k for expanded uncertainty",
          "title": "Coverage Factor"
        },
        "kind": {
          "default": "unknown",
          "enum": [
            "standard",
            "expanded",
            "bounds",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lower bound (kind='bounds')",
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "upper bound (kind='bounds')",
          "title": "Upper"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "standard/expanded uncertainty in the quantity unit",
          "title": "Value"
        }
      },
      "title": "Uncertainty",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/FulongLi/AIPE-Magnetics-Database/v0.2.0/schemas/v0.2/properties/core_loss_measurement.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The 'properties' object of a 'core_loss_measurement' record (CoreLossMeasurementProperties). Table of scalar core-loss points measured on one specimen.",
  "properties": {
    "dataset_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Ref"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "instrument": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instrument"
    },
    "material_ref": {
      "title": "Material Ref",
      "type": "string"
    },
    "method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/LossReferencePoint"
      },
      "minItems": 1,
      "title": "Points",
      "type": "array"
    },
    "specimen_core_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Specimen Core Ref"
    },
    "specimen_description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Specimen Description"
    }
  },
  "required": [
    "material_ref",
    "points"
  ],
  "title": "AIPE magnetic record v0.2 - core_loss_measurement properties",
  "type": "object"
}
